# syntax=docker/dockerfile:1
# Production image generated by gherkin-ai (Elixir · Phoenix).
# Configure it with environment variables only: DATABASE_URL, AMQP_URL, JWT_SECRET, OTEL_EXPORTER_OTLP_ENDPOINT.
# Listens on 4000; probes: liveness /health, readiness /health.

FROM elixir:1.17
ENV MIX_ENV=prod MIX_HOME=/opt/mix HEX_HOME=/opt/hex PORT=4000
RUN mix local.hex --force && mix local.rebar --force
RUN useradd --system --uid 10001 --no-create-home app
WORKDIR /app
COPY mix.exs mix.lock* ./
RUN mix deps.get --only prod && mix deps.compile
COPY . .
RUN mix compile && chown -R 10001 /app
# SECRET_KEY_BASE must be provided by the platform (secret manager).
USER 10001
EXPOSE 4000
CMD ["mix", "phx.server"]
